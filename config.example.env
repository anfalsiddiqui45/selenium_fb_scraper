# Example environment variables. Copy to `.env` or export in your shell.
# Do NOT commit a `.env` with real credentials into git.

# Path to a Chrome user-data directory (keep this outside the repo!)
USER_DATA_DIR=/home/you/.config/google-chrome/Profile\ 1

# Optional: Facebook credentials (RECOMMENDED: do not store in files)
#FB_EMAIL=your-email@example.com
#FB_PASSWORD=your-password
